{
    "name": "tbdb",
    "version": "0.0.18",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "repository": "https://github.com/qzrzz/TableDB.git",
    "homepage": "https://github.com/qzrzz/TableDB",
    "scripts": {
        "build": "rslib build && npm run docs:build",
        "dev": "rslib build --watch",
        "test": "vitest",
        "release": "npm run test && npm run build && npm version patch --no-git-tag-version && npm publish && cnpm sync tbdb",
        "bench:tree": "node --import tsx src/extension/tree/test/benchmark/table-tree.bench.ts",
        "bench:tree:all": "TABLE_TREE_BENCH_ADAPTERS=sqlite,mongodb node --import tsx src/extension/tree/test/benchmark/table-tree.bench.ts",
        "docs:dev": "starmap --rebuild --port=4811",
        "docs:build": "starmap build --buildDir=docs"
    },
    "devDependencies": {
        "@fontsource/jetbrains-mono": "5.2.8",
        "@rslib/core": "^0.21.5",
        "@types/better-sqlite3": "9.6.0",
        "@types/fs-extra": "11.0.4",
        "@types/node": "^22",
        "chalk": "5.6.2",
        "fake-indexeddb": "6.2.5",
        "fs-extra": "11.3.3",
        "tinybench": "6.0.0",
        "tsx": "4.22.4",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@fontsource/google-sans-code": "5.2.3",
        "@fontsource/inter": "5.2.8",
        "better-sqlite3": "13.0.3",
        "es-toolkit": "1.50.0",
        "fzz": "*",
        "indexless": "1.0.2",
        "mongodb": "7.0.0",
        "vitest": "4.1.10",
        "zstd-napi": "0.0.12"
    },
    "trustedDependencies": [
        "zstd-napi",
        "better-sqlite3"
    ],
    "overrides": {
        "better-sqlite3": "13.0.3"
    },
    "keywords": [
        "sqlite",
        "orm",
        "mongodb"
    ],
    "author": "git@qzrzz.com",
    "license": "MIT",
    "packageManager": "bun@1.3.5",
    "publishConfig": {
        "registry": "https://registry.npmjs.org"
    }
}
