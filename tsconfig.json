{
    "compilerOptions": {
        "lib": ["ES2024", "DOM"],
        "module": "ESNext",
        "target": "es2024",
        "allowJs": true,
        "noEmit": true,
        "strict": true,
        "rootDir": "./src",
        "skipLibCheck": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "useDefineForClassFields": true,
        "allowImportingTsExtensions": true,
        "paths": {
            "tbdb": ["./src/index.ts"]
        }
    },
    "include": ["src"]
}
