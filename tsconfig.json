{
    "compilerOptions": {
        "lib": [
            "ES2024",
            "DOM"
        ],
        "module": "ESNext",
        "target": "es2024",
        "types": [
            "vitest/globals"
        ],
        "allowJs": true,
        "noEmit": true,
        "strict": true,
        "rootDir": "./src",
        "skipLibCheck": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "moduleResolution": "bundler",
        "useDefineForClassFields": true,
        "allowImportingTsExtensions": true,
        "baseUrl": ".",
        "paths": {
            "tbdb": [
                "./src/index.ts"
            ]
        }
    },
    "include": [
        "src"
    ]
}